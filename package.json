{
  "name": "3a-strategy-trading-bot",
  "version": "1.0.0",
  "description": "3A Strategy Trading Bot - 24/7 Signal Detection with Telegram Notifications",
  "main": "server/server.ts",
  "scripts": {
    "start": "ts-node --project server/tsconfig.json server/server.ts",
    "dev": "nodemon",
    "build": "tsc --project server/tsconfig.json",
    "test": "jest",
    "dev:all": "concurrently \"npm run dev\" \"npm run client\"",
    "client": "cd client && npm start",
    "build:client": "cd client && npm run build",
    "install:all": "npm install && cd client && npm install"
  },
  "keywords": [
    "trading",
    "signals",
    "crypto",
    "telegram",
    "3a-strategy"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "moment-timezone": "^0.6.1",
    "node-cron": "^3.0.3",
    "okx-api": "^3.1.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "concurrently": "^9.2.1",
    "jest": "^30.3.0",
    "nodemon": "^3.0.1",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
